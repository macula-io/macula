%% config/sys.config — macula SDK v2 default runtime config.
[
    {kernel, [
        {logger_level, info},
        {logger, [
            {handler, default, logger_std_h, #{
                formatter => {logger_formatter, #{
                    single_line => true,
                    template => [time, " ", level, " ", pid, " ", mfa, " ", msg, "\n"]
                }}
            }}
        ]}
    ]},
    {macula_identity, [
        {puzzle_difficulty, 8}
    ]}
].
