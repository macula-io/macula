%% rebar.config — macula SDK v2 (umbrella).
%%
%% V2 rebirth: V1 (1.4.23) lives on main; v2 develops here.
%% See plans/PLAN_MACULA_V2_ROOT.md for scope.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_unused_vars,
    warn_shadow_vars,
    warn_unused_import,
    warn_obsolete_guard
]}.

{deps, []}.

{pre_hooks, [
    {compile, "sh priv/build-macula-quic.sh"}
]}.

{project_plugins, [rebar3_ex_doc]}.

{dialyzer, [
    {warnings, [unknown, no_return, error_handling]},
    {plt_apps, top_level_deps},
    {base_plt_apps, [erts, kernel, stdlib, crypto, public_key, ssl]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls
]}.

{profiles, [
    {test, [
        {deps, [
            {proper, "1.4.0"},
            {meck, "0.9.2"}
        ]},
        {erl_opts, [nowarn_export_all, debug_info]}
    ]}
]}.

{ct_opts, [
    {sys_config, "./config/sys.config"}
]}.

{shell, [
    {apps, [macula]},
    {config, "./config/sys.config"}
]}.

{ex_doc, [
    {source_url, <<"https://github.com/macula-io/macula">>},
    {extras, ["README.md", "CHANGELOG.md", "LICENSE"]},
    {main, "README.md"},
    {assets, #{"assets" => "assets"}},
    {logo, "artwork/logo.svg"}
]}.

{hex, [
    {doc, #{provider => ex_doc}},
    {licenses, ["Apache-2.0"]},
    {links, #{
        <<"GitHub">> => <<"https://github.com/macula-io/macula">>,
        <<"Documentation">> => <<"https://hexdocs.pm/macula">>,
        <<"Changelog">> => <<"https://github.com/macula-io/macula/blob/main/CHANGELOG.md">>
    }},
    {description, <<"Macula SDK v2 — Ed25519 identity, PKARR records, BERT frames, QUIC transport, peering state machine. Protocol primitives for the Macula mesh.">>}
]}.
