{erl_opts, [debug_info]}.

%% The same plugin version macula's lint profile pins.
{project_plugins, [{rebar3_lint, "5.0.4"}]}.

%% Only the nesting rule, at macula's level, so every reported line is a
%% nesting verdict.
{elvis, [
    {rulesets, #{
        nesting_only => [
            {elvis_style, no_deep_nesting, #{level => 2}}
        ]
    }},
    {config, [
        #{files => ["src/**/*.erl"], ruleset => nesting_only}
    ]}
]}.
