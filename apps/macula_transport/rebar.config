%% rebar.config — macula_transport.
%%
%% This app carries the Quinn QUIC NIF (`native/macula_quic/`). The pre_hook
%% builds the NIF on every compile (idempotent — skips when artifact is newer
%% than source). Keeping the NIF inside the sub-app lets consumers fetch
%% macula_transport via `{git_subdir, ...}` without pulling the whole umbrella.
{pre_hooks, [
    {compile, "sh priv/build-macula-quic.sh"}
]}.
